rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reports — public read, no client writes (pipeline writes via Admin SDK)
    match /reports/{reportId} {
      allow read: if true;
      allow write: if false;
    }

    // User tokens — owner writes their own, no client reads (Cloud Function reads via Admin SDK)
    match /user_tokens/{userId} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
