# ============================================
# VOXIRO — PIPELINE ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Firebase ---
# Path to the service account JSON you downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Your Firebase project ID (found in Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=...

# --- Anthropic (Claude API) ---
# Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Alerts RSS Feeds ---
# Paste each RSS URL from google.com/alerts here
# Add as many as you created
GOOGLE_ALERTS_RSS_URLS=https://www.google.com/alerts/feeds/YOUR_FEED_1,https://www.google.com/alerts/feeds/YOUR_FEED_2

# --- Google Geocoding API ---
# Needed to convert "Lekki Phase 1" → { lat, lng }
# Get from console.cloud.google.com → Enable Geocoding API → Create API Key
GOOGLE_GEOCODING_API_KEY=AIza...

# --- Pipeline Config ---
# How often to run the scraper (in minutes)
SCRAPE_INTERVAL_MINUTES=30

# Set to 'true' to log everything during development
DEBUG=true
